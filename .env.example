# Drizzle (local libsql — used for db:reset and unit tests)
DATABASE_URL=file:local.db

# Required in production — validated at boot by src/lib/server/env.ts.
# Set as an environment variable on Cloudflare Pages (Workers & Pages → the
# project → Settings → Environment variables). Generate the secret with:
#   openssl rand -base64 32
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# HMAC key for guest-order capability cookies (checkout success page access).
# Required in production — validated at boot by src/lib/server/env.ts.
# Generate with: openssl rand -base64 32
ORDER_ACCESS_SECRET=""

# PostHog product analytics (public key, inlined at build time)
# PUBLIC_POSTHOG_KEY=""

# Cloudflare D1 (drizzle-kit d1-http driver + remote wrangler commands)
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_DATABASE_ID=""
# CLOUDFLARE_D1_TOKEN=""
# CLOUDFLARE_API_TOKEN=""

# Local `wrangler pages dev` secrets live in .dev.vars (see .dev.vars.example);
# `.dev.vars` and `.env` are mutually exclusive — .dev.vars wins.

# ---------------------------------------------------------------------------
# Email (optional — transactional emails are best-effort, never block orders)
# ---------------------------------------------------------------------------
# Uses the Cloudflare Email Service `send_email` binding configured in
# wrangler.jsonc. The domain must be onboarded:
#   npx wrangler email sending enable yourdomain.com
#
# EMAIL_API_KEY:       Not used by the send_email binding (binding needs no
#                      API key). Kept for future REST API fallback.
# EMAIL_FROM:          Sender address. Must use the onboarded domain.
#                      Default: "Beeking Etman <noreply@beeking-etman-website.pages.dev>"
# EMAIL_API_KEY=""
# EMAIL_FROM="Beeking Etman <noreply@beeking-etman-website.pages.dev>"

# ---------------------------------------------------------------------------
# SMTP (optional — used by Better Auth for password-reset emails)
# ---------------------------------------------------------------------------
# Better Auth calls sendResetPassword when a user requests a reset. The
# callback delegates to the Cloudflare Email Service binding, so these
# are reserved for a future direct-SMTP fallback.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
