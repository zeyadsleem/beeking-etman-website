# Drizzle
DATABASE_URL=file:local.db

# adapter-node runtime (production). Optional: the Dockerfile sets HOST/PORT,
# and the app reads BODY_SIZE_LIMIT from here when non-default.
# PORT=3000
# HOST=0.0.0.0
# BODY_SIZE_LIMIT=512000

# Required in production — validated at boot by src/lib/server/env.ts.
# Generate the secret with: openssl rand -base64 32
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
