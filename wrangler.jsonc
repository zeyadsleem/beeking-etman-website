{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beeking-etman-website",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_als", "nodejs_compat"],
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "dev": {
    "port": 4173,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beeking",
      "database_id": "93fc332c-83b9-4cc0-abbc-5b08d5ccfbbc",
      "preview_database_id": "DB",
      "migrations_dir": "drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "8b48e8ac78804d37bd07d229de466821",
    },
  ],
  // NOTE: `send_email` binding is intentionally omitted — Cloudflare Pages does
  // not support it in the Wrangler Pages configuration (build validation fails),
  // which previously blocked all production deploys. src/lib/server/email.ts
  // degrades gracefully when the EMAIL binding is absent.
}
