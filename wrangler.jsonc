{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beeking-etman-website",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_als", "nodejs_compat"],
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "dev": {
    "port": 4173,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beeking",
      "database_id": "ba736038-a74b-4a94-b43f-1ff088e0d675",
      "preview_database_id": "DB",
      "migrations_dir": "drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "8b48e8ac78804d37bd07d229de466821",
    },
  ],
  // Email Service — send transactional emails via Cloudflare's native binding.
  // Domain must be onboarded: `npx wrangler email sending enable yourdomain.com`
  // For local dev, add "remote": true to proxy sends to the real service.
  "send_email": [{ "name": "EMAIL" }],
  // // Cron trigger skeleton (Phase 6: abandoned-cart recovery).
  // // Cron triggers require a Workers deployment (not Pages).
  // // See src/lib/server/cron.ts for the handler skeleton.
  // [[cron]]
  // pattern = "0 8 * * *"   // daily at 08:00 UTC (10:00 Cairo)
  // handler = "email"
}
